ARG SOURCE_COMMIT=__SOURCE_COMMIT__
RUN test -n "$SOURCE_COMMIT" \
    && test "${#SOURCE_COMMIT}" -eq 40 \
    && case "$SOURCE_COMMIT" in *[!0123456789abcdef]*) exit 1;; esac \
    && apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone https://github.com/BlueSkyXN/ImageMagickAPI-HFS.git . \
    && git fetch --no-tags origin "$SOURCE_COMMIT" \
    && git checkout --detach "$SOURCE_COMMIT" \
